# Development image for compose.dev.yml: the source is mounted at /app, so the virtualenv lives
# outside of it (/opt/venv). Rebuild after changing the dependencies (uv.lock).
# Runs as root on purpose: with rootless Docker that is the host user, who owns the mounted source.
FROM ghcr.io/astral-sh/uv:python3.14-trixie

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# With the dev dependencies, so that the tests run in the container too.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

EXPOSE 8000
