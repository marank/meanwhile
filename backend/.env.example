# Copy to backend/.env and keep one of the two email setups below.
# Without EMAIL_HOST, emails are printed to the backend's console.

# --- Option A: Mailpit (development) ----------------------------------------------------------
# docker compose -f docker-compose.dev.yml up -d; emails are shown at http://localhost:8025.
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=calendar@localhost

# Invitations name this address as organizer, so answers from mail programs go there;
# `manage.py fetch_imip --mailpit http://localhost:8025` reads them from Mailpit.
IMIP_ADDRESS=calendar@localhost

# --- Option B: a real mail server (SMTP) ------------------------------------------------------
# Port 587 with STARTTLS (EMAIL_USE_TLS) is the usual choice; port 465 uses implicit TLS
# (EMAIL_USE_SSL) instead. Set only one of the two.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=calendar@example.com
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=calendar@example.com

# Links in emails (answer page, "Open in app"); in development they point to the Vite dev server.
# BASE_URL=https://calendar.example.com

# Answers to invitations: the mailbox that receives them, read by `manage.py fetch_imip` (IMAP).
# Run it every few minutes (cron). Without IMIP_ADDRESS, answers go to the organizer's own address.
# IMIP_ADDRESS=calendar@example.com
# IMIP_IMAP_HOST=imap.example.com
# IMIP_IMAP_PORT=993
# IMIP_IMAP_USER=calendar@example.com
# IMIP_IMAP_PASSWORD=change-me
# IMIP_IMAP_SSL=true
# IMIP_IMAP_FOLDER=INBOX
