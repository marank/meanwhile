{
  // Everyday commands for VS Code. Each task only calls a recipe of the justfile, where the
  // commands live (CI calls the same recipes). AGENTS.md and the README refer to these labels.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "Django (:8000, SQLite, jobs in-process) and Vite (:6326)",
      "dependsOn": ["dev: backend", "dev: frontend"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "dev: backend",
      "type": "shell",
      "command": "just dev-backend",
      "isBackground": true,
      "presentation": { "group": "dev", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "dev: frontend",
      "type": "shell",
      "command": "just dev-frontend",
      "isBackground": true,
      "presentation": { "group": "dev", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "dev: services",
      "detail": "Optional: PostgreSQL, Redis and Mailpit like CI; then DB_HOST=localhost in .env",
      "type": "shell",
      "command": "just services",
      "problemMatcher": []
    },
    {
      "label": "dev: worker",
      "detail": "The task queue's worker; only with PostgreSQL (DB_HOST)",
      "type": "shell",
      "command": "just dev-worker",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: docker stack",
      "detail": "The whole development stack in Docker (http://localhost:6326)",
      "type": "shell",
      "command": "just docker-dev",
      "isBackground": true,
      "problemMatcher": []
    },
    { "label": "setup", "detail": "Install all dependencies", "type": "shell", "command": "just setup", "problemMatcher": [] },
    {
      "label": "check",
      "detail": "Everything CI checks",
      "type": "shell",
      "command": "just check",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    { "label": "check: backend", "type": "shell", "command": "just check-backend", "problemMatcher": [] },
    { "label": "check: frontend", "type": "shell", "command": "just check-frontend", "problemMatcher": [] },
    {
      "label": "api: types",
      "detail": "After API changes: schema -> frontend/openapi.json -> src/api/schema.d.ts",
      "type": "shell",
      "command": "just api-types",
      "problemMatcher": []
    },
    {
      "label": "django: makemigrations",
      "detail": "After model changes; commit the migrations",
      "type": "shell",
      "command": "just migrations",
      "problemMatcher": []
    },
    { "label": "django: migrate", "type": "shell", "command": "just migrate", "problemMatcher": [] },
    {
      "label": "i18n: update backend messages",
      "detail": "Then translate backend/locale/de/LC_MESSAGES/django.po",
      "type": "shell",
      "command": "just messages",
      "problemMatcher": []
    },
    { "label": "i18n: compile backend messages", "type": "shell", "command": "just compile-messages", "problemMatcher": [] },
    {
      "label": "env: sync",
      "detail": "Bring .env up to date with .env.example, keeping its values (old one as .env.bak)",
      "type": "shell",
      "command": "just sync-env",
      "problemMatcher": []
    },
    {
      "label": "docker: up",
      "detail": "Build the image and start the production stack (http://127.0.0.1:6326)",
      "type": "shell",
      "command": "just docker-up",
      "problemMatcher": []
    },
    { "label": "docker: down", "type": "shell", "command": "just docker-down", "problemMatcher": [] }
  ]
}
