{
  // Everyday commands. The "check" tasks run what CI runs (.gitea/workflows/build.yaml);
  // keep both in sync. Commands use only `&&` chaining and task options for cwd/env, so
  // they work in bash, zsh, cmd and PowerShell 7.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "Django (:8000) and Vite (:6326) dev servers; needs \"dev: services\" running",
      "dependsOn": ["dev: backend", "dev: frontend"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "dev: services",
      "detail": "PostgreSQL, Redis and Mailpit of compose.dev.yml for the dev servers",
      "type": "shell",
      "command": "docker compose -f compose.dev.yml up -d postgres redis mailpit",
      "problemMatcher": []
    },
    {
      "label": "dev: backend",
      "type": "shell",
      "command": "uv run python manage.py migrate && uv run python manage.py runserver",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": { "DEBUG": "true", "REDIS_URL": "redis://localhost:6379/0" }
      },
      "isBackground": true,
      "presentation": { "group": "dev", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "dev: frontend",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "group": "dev", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "dev: docker stack",
      "detail": "The whole development stack in Docker (http://localhost:6326)",
      "type": "shell",
      "command": "docker compose -f compose.dev.yml up --build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "check",
      "detail": "Everything CI checks, backend and frontend",
      "dependsOn": ["check: backend", "check: deploy settings", "check: frontend"],
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "check: backend",
      "detail": "ruff, mypy, deptry, migrations, Django checks, OpenAPI schema, pytest with coverage (needs \"dev: services\")",
      "type": "shell",
      "command": "uv sync --locked && uv run ruff check . && uv run ruff format --check . && uv run mypy . && uv run deptry . && uv run python manage.py makemigrations --check --dry-run && uv run python manage.py check --fail-level WARNING && uv run python manage.py export_openapi_schema --api core.api.api --indent 2 --output ../frontend/openapi.json && git diff --exit-code -- ../frontend/openapi.json && uv run pytest -q --cov --cov-report=term --cov-fail-under=90",
      "options": { "cwd": "${workspaceFolder}/backend", "env": { "DEBUG": "true" } },
      "problemMatcher": []
    },
    {
      "label": "check: deploy settings",
      "detail": "Django deploy checks with production-like settings",
      "type": "shell",
      "command": "uv run python manage.py check --deploy --fail-level WARNING",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "DEBUG": "false",
          "APP_URLS": "https://app.example.com",
          "SECRET_KEY": "local-deploy-check-not-secret-but-long-and-random-enough-0123456789abcdef",
          "DB_PASSWORD": "not-used-by-the-checks"
        }
      },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "check: frontend",
      "detail": "prettier, oxlint, eslint, knip, type-check, vitest with coverage, API types, build, size, licenses",
      "type": "shell",
      "command": "pnpm install --frozen-lockfile && pnpm check && pnpm api:types && git diff --exit-code -- src/api/schema.d.ts && pnpm build-only && pnpm size && pnpm check:licenses",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "api: types",
      "detail": "Export the backend's OpenAPI schema and generate the frontend's API types from it",
      "type": "shell",
      "command": "uv run python manage.py export_openapi_schema --api core.api.api --indent 2 --output ../frontend/openapi.json && cd ../frontend && pnpm api:types",
      "options": { "cwd": "${workspaceFolder}/backend", "env": { "DEBUG": "true" } },
      "problemMatcher": []
    },
    {
      "label": "django: makemigrations",
      "type": "shell",
      "command": "uv run python manage.py makemigrations",
      "options": { "cwd": "${workspaceFolder}/backend", "env": { "DEBUG": "true" } },
      "problemMatcher": []
    },
    {
      "label": "django: migrate",
      "type": "shell",
      "command": "uv run python manage.py migrate",
      "options": { "cwd": "${workspaceFolder}/backend", "env": { "DEBUG": "true" } },
      "problemMatcher": []
    },
    {
      "label": "docker: up",
      "detail": "Build and start the production stack (compose.yml, http://localhost:6326)",
      "type": "shell",
      "command": "docker compose up -d --build",
      "problemMatcher": []
    },
    {
      "label": "docker: down",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    }
  ]
}
