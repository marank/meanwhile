{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: install dependencies",
      "type": "shell",
      "command": "cd ${workspaceFolder}/backend && uv sync",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Backend: run migrations",
      "type": "shell",
      "command": "cd ${workspaceFolder}/backend && DJANGO_SETTINGS_MODULE=config.settings uv run python manage.py migrate",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Backend: run dev server",
      "type": "shell",
      "command": "cd ${workspaceFolder}/backend && DJANGO_SETTINGS_MODULE=config.settings uv run python manage.py runserver 0.0.0.0:8000",
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend: run checks",
      "type": "shell",
      "command": "cd ${workspaceFolder}/backend && DJANGO_SETTINGS_MODULE=config.settings uv run python manage.py check",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend: install dependencies",
      "type": "shell",
      "command": "cd ${workspaceFolder}/frontend && pnpm install",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Frontend: dev server",
      "type": "shell",
      "command": "cd ${workspaceFolder}/frontend && pnpm dev",
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: build",
      "type": "shell",
      "command": "cd ${workspaceFolder}/frontend && pnpm build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Frontend: type check",
      "type": "shell",
      "command": "cd ${workspaceFolder}/frontend && pnpm type-check",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docker: compose up",
      "type": "shell",
      "command": "cd ${workspaceFolder} && docker compose up --build",
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
