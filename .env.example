# Configuration of all setups: copy to .env (project root) and fill in. Read by
# docker-compose.yml (production), docker-compose.dev.yml and the backend run without Docker.
# The Compose files set the wiring themselves (database, Redis; Mailpit in development).

# The domain the app is reached at over HTTPS (allowed host, trusted origin, links in emails).
# Production only.
DOMAIN=meanwhile.example.com

# Random values, e.g. `openssl rand -hex 32` (letters and digits only for the password).
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# Whether anyone may sign up. Signed-in users can look each other up by name and email.
ALLOW_REGISTRATION=false
# The admin user, created or updated on every start (`manage.py ensure_admin`). The password is
# needed to create the user; an existing user of ADMIN_EMAIL becomes admin and gets it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# --- Email (SMTP) -----------------------------------------------------------------------------
# Without EMAIL_HOST no emails are sent (in development they're printed to the console);
# docker-compose.dev.yml sends them to Mailpit. Port 587 uses STARTTLS (EMAIL_USE_TLS); for
# port 465 set EMAIL_USE_SSL=true and EMAIL_USE_TLS=false instead.
# Mailpit without Docker for the backend: EMAIL_HOST=localhost, EMAIL_PORT=1025, EMAIL_USE_TLS=false.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=meanwhile@example.com

# --- Answers to invitations (iMIP over IMAP) --------------------------------------------------
# Invitations name IMIP_ADDRESS as organizer; the worker reads the answers from its mailbox every
# five minutes. Without IMIP_ADDRESS, answers go to the organizer's own address; without
# IMIP_IMAP_HOST, nothing is read.
IMIP_ADDRESS=
IMIP_IMAP_HOST=
IMIP_IMAP_USER=
IMIP_IMAP_PASSWORD=

# --- Optional, with their defaults ------------------------------------------------------------
# Where the production container's HTTP port is published.
# APP_BIND=127.0.0.1:6326
# uvicorn processes.
# WEB_WORKERS=4
# Live updates between processes; the backend without Docker: redis://localhost:6379/0.
# REDIS_URL=
# SESSION_COOKIE_AGE_DAYS=14
# IMIP_IMAP_PORT=993
# IMIP_IMAP_SSL=true
# IMIP_IMAP_FOLDER=INBOX
