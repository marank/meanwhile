# Serves the built frontend and passes the backend's paths on to uvicorn (127.0.0.1:8000).
# Rendered by start-nginx (envsubst); only the three ${…} placeholders are replaced. HTTPS is
# terminated in front of the container.

# Is the direct peer one of TRUSTED_PROXIES?
geo $realip_remote_addr $from_trusted_proxy {
    default 0;
${TRUSTED_GEO}
}

# Client scheme and host: X-Forwarded-Proto/-Host only from trusted proxies, else the request's own.
map "$from_trusted_proxy:$http_x_forwarded_proto" $client_proto {
    "~^1:(?<fwd>https?)$" $fwd;
    default $scheme;
}
map "$from_trusted_proxy:$http_x_forwarded_host" $client_host {
    "~^1:(?<fwd>[^,\s]+)" $fwd;
    default $http_host;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 8080 default_server;
    server_name _;
    client_max_body_size 10m;

    # The client's address: the proxy in front (TRUSTED_PROXIES) adds it to X-Forwarded-For;
    # whatever a client puts in there itself is ignored. The backend takes the address from here
    # alone; its failed-login limits count by it.
${REAL_IP_CONFIG}

    root /srv/spa;

    location ~ ^/(api|ics|caldav|\.well-known/caldav)(/|$) {
        include /etc/nginx/django_proxy.conf;
    }

    # Brute-force brake in front of allauth's own limit: per client address, see nginx.conf.
    location = /api/auth/v1/auth/login {
        limit_req zone=login burst=5 nodelay;
        include /etc/nginx/django_proxy.conf;
    }

    # Live updates; longer than the app's heartbeat (25 s), so idle connections stay open.
    location /ws/ {
        include /etc/nginx/django_proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

${ADMIN_LOCATION}

    # Django admin's static files.
    location /django-static/ {
        alias /app/staticfiles/;
        expires 7d;
        access_log off;
        include /etc/nginx/security_headers.conf;
    }

    # File names carry their content's hash.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/security_headers.conf;
        try_files $uri =404;
    }

    # The app; every other path is a route of the app. index.html must never be cached.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/security_headers.conf;
    }
}
