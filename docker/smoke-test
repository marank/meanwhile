#!/bin/sh
# Smoke test of a running container, run inside it — the one place for these probes:
#   CI:  docker exec <container> sh /usr/local/bin/smoke-test app|worker
# app:    nginx serves the SPA, static files and the API, the Django admin is closed while /admin
#         is the app's own page, every supervisord program (nginx, uvicorn) runs.
# worker: the task queue's worker runs and a backup can be written.
# Both:   nothing runs as root, the root filesystem is read-only, /data is writable.
# Stops at the first failure.
set -eu
cd /app
role="${1:?usage: smoke-test app|worker}"

fail() { echo "smoke test ($role) failed: $*" >&2; exit 1; }
probe() { python /usr/local/bin/healthcheck "$1" "$2" || fail "$1 did not answer $2"; }

case "$role" in
  app)
    probe /api/health 200
    probe / 200
    probe /some/client/route 200
    probe /admin 200
    probe /django-static/admin/css/base.css 200
    probe /api/users/me 401
    probe /api/auth/v1/auth/session 401
    case "$(echo "${ADMIN_ENABLED:-false}" | tr '[:upper:]' '[:lower:]')" in
      1|true|yes|on) ;;
      *) probe /django-admin/ 404 ;;
    esac
    status=$(supervisorctl -c /etc/supervisord.conf status || true)
    echo "$status"
    [ -n "$status" ] || fail "supervisorctl gave no status"
    if echo "$status" | grep -v RUNNING >/dev/null; then fail "not every program is running"; fi
    ;;
  worker)
    # [p]: the pattern does not match grep's own command line.
    grep -qa '[p]rocrastinate' /proc/[0-9]*/cmdline || fail "the task queue's worker is not running"
    # pg_dump in the image must accept the server's version and write into /backups.
    python manage.py backup_database || fail "backup"
    ;;
  *) fail "unknown role" ;;
esac

[ "$(id -u)" != 0 ] || fail "the container runs as root"
if grep -l '^Uid:[[:space:]]*0[[:space:]]' /proc/[0-9]*/status 2>/dev/null | grep -q .; then
  fail "a process runs as root"
fi
if touch /app/.probe 2>/dev/null; then fail "the root filesystem is writable"; fi
mkdir /data/.probe && rmdir /data/.probe || fail "/data is not writable"

echo "smoke test ($role) passed"
