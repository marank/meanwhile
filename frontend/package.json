{
  "name": "meanwhile-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm/')) { console.error('Use pnpm to install the frontend packages.'); process.exit(1) }\"",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "oxlint && eslint . && knip",
    "format": "prettier --write --experimental-cli src/ scripts/",
    "generate:palettes": "node scripts/generate-calendar-palettes.ts && prettier --write src/services/calendarPalettes.ts",
    "lint:fix": "oxlint --fix && eslint . --fix --cache",
    "format:check": "prettier --check --experimental-cli src/ scripts/",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test:coverage",
    "size": "size-limit",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@fullcalendar/vue3": "7.1.0",
    "lucide-vue-next": "0.468.0",
    "pinia": "^4.0.3",
    "temporal-polyfill": "^1.0.5",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "knip": "^6.43.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "size-limit": [
    {
      "name": "JS",
      "path": "dist/assets/*.js",
      "limit": "300 kB"
    },
    {
      "name": "CSS",
      "path": "dist/assets/*.css",
      "limit": "19 kB"
    }
  ]
}
