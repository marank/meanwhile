{
  "name": "meanwhile-frontend",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm/')) { console.error('Use pnpm to install the frontend packages.'); process.exit(1) }\"",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "oxlint --deny-warnings && eslint . && knip",
    "format": "prettier --write --experimental-cli src/ scripts/",
    "generate:palettes": "node scripts/generate-calendar-palettes.ts && prettier --write src/services/calendarPalettes.ts",
    "api:types": "openapi-typescript openapi.json --default-non-nullable false -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "lint:fix": "oxlint --fix && eslint . --fix --cache",
    "format:check": "prettier --check --experimental-cli src/ scripts/",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test:coverage && pnpm check:duplication",
    "check:duplication": "jscpd --config .jscpd.json",
    "size": "size-limit",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@fullcalendar/vue3": "7.1.5",
    "@lucide/vue": "^1.72.0",
    "pinia": "^4.1.0",
    "temporal-polyfill": "^1.0.8",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.19",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node26": "^26.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "jiti": "^2.7.0",
    "jscpd": "^5.4.3",
    "jsdom": "31.0.1",
    "knip": "^6.45.1",
    "npm-run-all2": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "size-limit": [
    {
      "name": "JS",
      "path": "dist/assets/*.js",
      "limit": "300 kB"
    },
    {
      "name": "CSS",
      "path": "dist/assets/*.css",
      "limit": "19 kB"
    }
  ]
}
