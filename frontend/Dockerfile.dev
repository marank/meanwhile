# Development image for compose.dev.yml: the source is mounted at /app, node_modules is a volume.
# Runs as root on purpose: with rootless Docker that is the host user, who owns the mounted source.
FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5

WORKDIR /app

# pnpm in the version of packageManager in package.json (the one place it is set).
COPY package.json /tmp/package.json
RUN npm install -g "$(node -p "require('/tmp/package.json').packageManager.split('+')[0]")"

EXPOSE 6326
